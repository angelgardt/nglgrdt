{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "tags": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "stats",
            "psychometrics",
            "research-design",
            "teaching",
            "biostat",
            "ux-research",
            "cognitive",
            "linguistics",
            "management"
          ]
        }
      },
      "pinned": {
        "default": false,
        "type": "boolean"
      },
      "hidden": {
        "default": false,
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      },
      "authors": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "venue": {
        "type": "string",
        "minLength": 1
      },
      "year": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100
      },
      "volume": {
        "type": "string",
        "minLength": 1
      },
      "issue": {
        "type": "string",
        "minLength": 1
      },
      "pages": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "default": "published",
        "type": "string",
        "enum": [
          "published",
          "in-press",
          "submitted"
        ]
      },
      "doi": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "authors",
      "title",
      "venue",
      "year"
    ],
    "additionalProperties": false
  }
}
