{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "tags": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "stats",
            "psychometrics",
            "research-design",
            "teaching",
            "biostat",
            "ux-research",
            "cognitive",
            "linguistics",
            "management"
          ]
        }
      },
      "pinned": {
        "default": false,
        "type": "boolean"
      },
      "hidden": {
        "default": false,
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      },
      "title": {
        "type": "object",
        "properties": {
          "ru": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ru"
        ],
        "additionalProperties": false
      },
      "role": {
        "type": "object",
        "properties": {
          "ru": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ru"
        ],
        "additionalProperties": false
      },
      "description": {
        "type": "object",
        "properties": {
          "ru": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ru"
        ],
        "additionalProperties": false
      },
      "methods": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ru": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ru"
          ],
          "additionalProperties": false
        }
      },
      "start": {
        "type": [
          "string",
          "integer"
        ],
        "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
        "description": "Дата в кавычках: \"YYYY\", \"YYYY-MM\" или \"YYYY-MM-DD\""
      },
      "end": {
        "type": [
          "string",
          "integer"
        ],
        "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$|^present$",
        "description": "Дата в кавычках (\"YYYY\", \"YYYY-MM\", \"YYYY-MM-DD\") или present"
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "featured": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "title"
    ],
    "additionalProperties": false
  }
}
