---
// Заглушка: настоящая английская визитка появится в итерации 3.
import { getEntry } from 'astro:content'
import { href } from '../lib/links.ts'

const profile = await getEntry('profile', 'profile')
if (!profile) throw new Error('Не найден src/data/profile.yaml')
const name = profile.data.name.en
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
  </head>
  <body>
    <main>
      <h1>{name}</h1>
      <p>The site is under construction.</p>
      <p>
        <a href={href('/data/', 'ru')} hreflang="ru">
          Data preview (in Russian)
        </a>
      </p>
    </main>
  </body>
</html>
